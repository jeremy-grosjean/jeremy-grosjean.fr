# jeremy-grosjean.fr : configuration du serveur web (Apache, hébergement OVHcloud)

Options -Indexes
ServerSignature Off
AddDefaultCharset utf-8
AddType "text/plain; charset=utf-8" .txt
AddType image/svg+xml .svg
AddType image/x-icon .ico
AddType application/manifest+json .webmanifest
AddType "text/vcard; charset=utf-8" .vcf
AddType font/woff .woff
AddType image/webp .webp
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Site statique : seules les lectures (GET, HEAD) sont acceptées, tout le reste est refusé (405)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$
  RewriteRule ^ - [R=405,L]
</IfModule>

# Une seule adresse propre : https://jeremy-grosjean.fr (HTTPS obligatoire, sans www)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
  RewriteCond %{HTTP_HOST} !^jeremy-grosjean\.fr$ [NC,OR]
  RewriteCond %{SERVER_PORT} ^80$
  RewriteRule ^ https://jeremy-grosjean.fr%{REQUEST_URI} [R=301,L]
</IfModule>

# En-têtes de sécurité
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; font-src 'self'; media-src 'none'; object-src 'none'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types jg; upgrade-insecure-requests"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "require-corp"
  Header always unset X-Powered-By
  Header set Cache-Control "no-cache"
  # Fichiers versionnés (?v=empreinte) : gardés un an par le navigateur, l'empreinte change à chaque modification.
  # Jamais les pages HTML ni le service worker, qui restent en no-cache.
  <If "%{QUERY_STRING} =~ /(^|&)v=/ && %{REQUEST_URI} =~ /\.(css|js|png|svg|ico|webmanifest|woff2?|webp|jpg)$/ && %{REQUEST_URI} !~ /sw\.js$/">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

# Service worker (mode hors ligne) : sa propre politique, limitée aux fichiers de ce site
<IfModule mod_headers.c>
  <Files "sw.js">
    Header always set Content-Security-Policy "default-src 'none'; connect-src 'self'"
  </Files>
</IfModule>

# Les fichiers cachés (sauf .well-known) ne sont jamais servis
<IfModule mod_rewrite.c>
  RewriteRule "(^|/)\.(?!well-known/)" - [F]
</IfModule>

# Photo : jamais répertoriée par les moteurs de recherche (ni résultats, ni Google Images).
# Les autres sites ne peuvent déjà pas l'afficher : Cross-Origin-Resource-Policy "same-origin" plus haut.
<IfModule mod_headers.c>
  <Files "jg.webp">
    Header set X-Robots-Tag "noindex, noimageindex"
  </Files>
</IfModule>
